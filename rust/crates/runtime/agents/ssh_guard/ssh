#!/bin/sh
# ssh - agent guard: every ssh that an agent process starts by name runs non-interactive and bounded.
#
# agent_environment (rust/crates/runtime/agents/src/agent_environment.rs) puts this directory on the PATH of every
# agent process, right after the gh wrapper. The script prepends three options and runs the real ssh found on PATH
# without this directory:
#
#   -o BatchMode=yes            no prompt: a login that needs a person fails at once with exit 255
#   -o ServerAliveInterval=15   probe the server every 15 seconds
#   -o ServerAliveCountMax=3    drop the connection after 3 unanswered probes, about 45 seconds
#
# ssh takes the first value of each parameter, and command-line options come before configuration files, so these
# options win over the caller's own -o values. A healthy server answers every probe, so a long command that prints
# nothing keeps running.
#
# A caller that names ssh by an absolute path, or rewrites PATH before it starts ssh, bypasses the guard.

set -u

# cd must not reroute or print: the self_dir lookup below needs plain chdir semantics.
unset CDPATH

# Unset PATH is treated as empty: the guard then fails below instead of searching the default path.
PATH=${PATH:-}

self_dir=$(cd -- "$(dirname -- "$0")" && pwd -P)

# Drop this directory from PATH everywhere it appears, preserving the other entries in order. Empty entries name
# the current directory and stay empty.
path_rest=$PATH
new_path=''
path_sep=''
while :; do
  case $path_rest in
    *:*)
      path_entry=${path_rest%%:*}
      path_rest=${path_rest#*:}
      path_more=1
      ;;
    *)
      path_entry=$path_rest
      path_more=0
      ;;
  esac
  if [ "$path_entry" != "$self_dir" ]; then
    new_path=$new_path$path_sep$path_entry
    path_sep=:
  fi
  [ "$path_more" = 1 ] || break
done
PATH=$new_path
export PATH

# Search PATH for an executable and print the path found. Relative entries resolve against the current directory,
# like execvp. An entry that resolves physically to this guard's own directory is skipped: the entry may spell that
# directory through a symlink or a relative path, which the string removal above does not catch, and exec'ing this
# script again would loop.
find_on_path() {
  find_name=$1
  find_rest=$PATH
  while :; do
    case $find_rest in
      *:*)
        find_dir=${find_rest%%:*}
        find_rest=${find_rest#*:}
        find_more=1
        ;;
      *)
        find_dir=$find_rest
        find_more=0
        ;;
    esac
    if [ -z "$find_dir" ]; then
      find_dir=.
    fi
    case $find_dir in
      /*) ;;
      *) find_dir=$PWD/$find_dir ;;
    esac
    if [ -x "$find_dir/$find_name" ]; then
      find_real_dir=$(cd -- "$find_dir" 2>/dev/null && pwd -P)
      if [ "$find_real_dir" != "$self_dir" ]; then
        printf '%s\n' "$find_dir/$find_name"
        return 0
      fi
    fi
    [ "$find_more" = 1 ] || return 1
  done
}

real_ssh=$(find_on_path ssh)
if [ -z "$real_ssh" ]; then
  echo "ssh guard: no ssh on the PATH outside $self_dir" >&2
  exit 127
fi

exec "$real_ssh" -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "$@"
