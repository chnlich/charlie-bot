  "expect": {
    "stdout": "{\n  \"session_id\": \"w1\",\n  \"run_id\": \"r1\"\n}\n",
    "stderr": "Worker spawned in the background; the completion summary arrives as an async wake-up.\n",
    "exit": 0,
    "requests": [
      {
        "method": "POST",
        "path": "/api/internal/delegate",
        "query": "",
        "headers": {
          "Authorization": null,
          "X-CharlieBot-Caller-Session": null,
          "Content-Type": "application/json"
        },
        "body": {
          "session_id": "s1",
          "description": "## Goal\nDo work.\n\n## Source Files\n- (none)\n\n## Required Behavior\nImplement the requested behavior.\n\n## Acceptance Tests\nRun focused tests.\n\n## Reviewer Checklist\nCheck the contract.\n\n## Out of Scope\nDo not change unrelated files.\n",
          "keep_worktree": false,
          "task_type": "implement",
          "delegate_invocation": {
            "task_type": "implement",
            "repo_path": "{root}",
            "base_branch": "main",
            "task_spec_file": "{root}/task_spec.md",
            "reviewer_context_file": null,
            "keep_worktree": false,
            "backend": null
          },
          "base_branch": "main",
          "repo_path": "{root}"
        }
      }
    ]
