#!/usr/bin/python3 -I
"""A synthetic `ncu` for the ncu crate's tests: `ncu --import <file> --csv --page details` prints the report's CSV."""

import json
import sys


def main(argv):
  if argv[:1] != ["--import"] or argv[2:] != ["--csv", "--page", "details"]:
    sys.stderr.write("ncu: this fake answers only --import <file> --csv --page details\n")
    return 2
  path = argv[1]
  try:
    with open(path, encoding="utf-8") as report:
      data = json.load(report)
  except (OSError, ValueError) as exc:
    sys.stderr.write(f"ncu: cannot import {path}: {exc}\n")
    return 1
  if "csv" not in data:
    sys.stderr.write(f"ncu: cannot import {path}: no details page\n")
    return 1
  sys.stdout.write(data["csv"])
  return 0


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
