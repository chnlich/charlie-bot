#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"
staged_files=()
while IFS= read -r -d '' file; do
  staged_files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [[ ${#staged_files[@]} -gt 0 ]]; then
  LEAK_SCAN_STAGED=1 tools/check-skills-host-leak.sh "${staged_files[@]}"
fi
