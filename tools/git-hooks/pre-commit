#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=()
while IFS= read -r file; do
  case "$file" in
    skills/*.md | prompts/*.md)
      staged_files+=("$file")
      ;;
    # The host-auth panel files are leak-scanned too; the list mirrors
    # check-skills-host-leak.sh's host_auth_scan.
    src/core/host_auth.py | src/api/host_auth.py | web/templates/host_auth.html | tests/test_host_auth.py)
      staged_files+=("$file")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ ${#staged_files[@]} -eq 0 ]]; then
  exit 0
fi

if ! scripts/check-skills-host-leak.sh "${staged_files[@]}"; then
  printf '%s\n' 'PII/host-specific leak detected in staged skills/prompts files. Fix or amend ~/.charliebot/skills_leak_patterns.local.txt. To bypass: git commit --no-verify (NOT recommended).' >&2
  exit 1
fi
