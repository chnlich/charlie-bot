[Unit]
Description=CharlieBot agent processes

# The agents' share: every agent process a session spawns runs here, so the share covers all of them
# together and holds all host memory except what the server and the system need. A full share ends
# its largest process while the server, outside it, keeps answering. Swap stays off so a full share
# never pushes the host into swap. A session's own 12 GiB cgroup stays inside this share.
#
# CPUWeight is the default value set on purpose: the explicit property is what makes systemd turn the
# cpu controller on down to this slice's subtree, where the server then writes each session cgroup's
# cpu.weight. Without it cpu stays out of the agents' cgroup.controllers and the sessions get no cpu
# share. The parent charliebot.slice needs no extra line: this property makes systemd enable cpu there.
[Slice]
CPUWeight=100
MemoryMax=80%
MemorySwapMax=0

[Install]
WantedBy=default.target
