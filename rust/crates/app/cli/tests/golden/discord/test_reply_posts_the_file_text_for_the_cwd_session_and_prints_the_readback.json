{
  "argv": [
    "discord",
    "reply",
    "--file",
    "{root}/reply.md",
    "--session",
    "abc"
  ],
  "cwd": "{root}",
  "files": {
    "home/config.yaml": "server:\n  port: {port}\n",
    "reply.md": "the answer"
  },
  "responses": [
    {
      "status": 200,
      "body": {
        "posted": true,
        "text": "the answer",
        "operator_only_note": null,
        "chars": 10,
