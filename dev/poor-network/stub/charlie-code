#!/bin/sh
# The bench's scripted backend: a stand-in for the charlie-code CLI, which the server runs once per turn. It prints the
# NDJSON that the backend reads: session_attached, the reply that POOR_NETWORK_REPLY_FILE holds, then result. It calls no
# model and reads no credential. A prompt that carries the marker bench-hold keeps its turn open, so the session stays
# running for the background load until the bench cancels it.
set -eu

task_file=
resume=
previous=
for argument in "$@"; do
  case "$previous" in
    --task-file) task_file=$argument ;;
    --resume) resume=$argument ;;
  esac
  previous=$argument
done

if [ -n "$resume" ]; then
  session_id=$resume
else
  session_id=$(cat /proc/sys/kernel/random/uuid)
fi
printf '{"type":"session_attached","session_id":"%s"}\n' "$session_id"

while IFS= read -r line; do
  printf '%s\n' "$line"
  sleep 0.05
done < "$POOR_NETWORK_REPLY_FILE"

if [ -n "$task_file" ] && grep -q 'bench-hold' "$task_file"; then
  # A cancel stops this shell; the sleep it waits on ends with it, so no orphan outlives the turn.
  sleep 600 &
  hold=$!
  trap 'kill "$hold" 2>/dev/null; exit 143' TERM INT
  wait "$hold" || true
fi
printf '{"type":"result","usage":{"input_tokens":1000,"output_tokens":2000}}\n'
