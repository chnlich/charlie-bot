  "expect": {
    "stdout": "{\"posted\": true, \"text\": \"the answer\", \"operator_only_note\": null, \"chars\": 10, \"chunks\": 1, \"over_budget\": false, \"answers\": \"summon-1\", \"attachments\": [\"answer.html\"]}\n",
    "stderr": "",
    "exit": 0,
    "requests": [
      {
        "method": "POST",
        "path": "/api/internal/discord/reply",
        "query": "",
        "headers": {
          "Authorization": null,
          "X-CharlieBot-Caller-Session": null,
          "Content-Type": "application/json"
        },
        "body": {
          "session_id": "abc",
          "text": "the answer"
        }
      }
    ]
