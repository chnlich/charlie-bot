#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# A feature package's leak_scan_files.txt names extra leak-scanned files; the
# staged set rides the same manifests as check-skills-host-leak.sh.
manifest_scan=()
shopt -s nullglob
for manifest in src/features/*/leak_scan_files.txt; do
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -n "$line" ]]; then
      manifest_scan+=("$line")
    fi
  done < "$manifest"
done
shopt -u nullglob

staged_files=()
while IFS= read -r file; do
  case "$file" in
    skills/*.md | prompts/*.md)
      staged_files+=("$file")
      continue
      ;;
  esac
  for scan_file in "${manifest_scan[@]}"; do
    if [[ "$file" == "$scan_file" ]]; then
      staged_files+=("$file")
      break
    fi
  done
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ ${#staged_files[@]} -eq 0 ]]; then
  exit 0
fi

if ! tools/check-skills-host-leak.sh "${staged_files[@]}"; then
  printf '%s\n' 'PII/host-specific leak detected in staged skills/prompts files. Fix or amend ~/.charliebot/skills_leak_patterns.local.txt. To bypass: git commit --no-verify (NOT recommended).' >&2
  exit 1
fi
