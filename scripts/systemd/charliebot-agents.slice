[Unit]
Description=CharlieBot agent processes

# The agents' share: every agent process a session spawns runs here, so the share covers all of them
# together and holds all host memory except what the server and the system need. A full share ends
# its largest process while the server, outside it, keeps answering. Swap stays off so a full share
# never pushes the host into swap. A session's own 12 GiB cgroup stays inside this share.
#
# CPUWeight and IOWeight are the default values set on purpose: the explicit property is what makes
# systemd turn the controller on down to this slice's subtree, where the server then writes each
# session cgroup's cpu.weight (and, once io reaches the user manager, io.weight). Without the property
# the controller stays out of the agents' cgroup.controllers and the sessions get no share — io stays
# out even after setup-io-share.sh delegates io, because systemd enables a controller toward a slice
# only for a unit property that needs it. The parent charliebot.slice needs no extra line: these
# properties make systemd enable the controllers there.
[Slice]
CPUWeight=100
IOWeight=100
MemoryMax=80%
MemorySwapMax=0

[Install]
WantedBy=default.target
