#!/usr/bin/env bash
# The stub gh: answers the authentication, repository, run and artifact queries from the gh_behavior/ directory beside
# it. A query's `--jq` filter runs over the JSON answer with jq, as gh runs it. `run download` copies the artifact
# fixture into the directory its --dir names.
here="${BASH_SOURCE[0]%/*}"
behavior="$here/gh_behavior"
filter=
previous=
for argument in "$@"; do
  if [ "$previous" = "--jq" ]; then
    filter="$argument"
  fi
  previous="$argument"
done
emit() {
  if [ -n "$filter" ]; then
    printf '%s\n' "$1" | jq --raw-output "$filter"
  else
    printf '%s\n' "$1"
  fi
}
case "$1 $2" in
  "auth status")
    test "$(cat "$behavior/auth")" = 1
    ;;
  "repo view")
    test "$(cat "$behavior/auth")" = 1 || exit 1
    cat "$behavior/slug"
    ;;
  "run list")
    # The repository has two workflows named CI, so gh resolves only the file name: any other selector fails with the
    # live gh's text for the shared name. A non-empty runs_error file is the failure of the query itself.
    workflow=
    previous=
    for argument in "$@"; do
      if [ "$previous" = "--workflow" ]; then
        workflow="$argument"
      fi
      previous="$argument"
    done
    if [ "$workflow" != ci.yml ]; then
      echo "could not resolve to a unique workflow; found: ci.yml pr-body.yml" >&2
      exit 1
    fi
    if [ -s "$behavior/runs_error" ]; then
      cat "$behavior/runs_error" >&2
      exit 1
    fi
    emit "$(cat "$behavior/runs")"
    ;;
  "run view")
    emit "$(cat "$behavior/jobs-$3" 2> /dev/null || printf '{"jobs": []}\n')"
    ;;
  "run download")
    test "$(cat "$behavior/download_ok")" = 1 || exit 1
    destination=
    previous=
    for argument in "$@"; do
      if [ "$previous" = "--dir" ]; then
        destination="$argument"
      fi
      previous="$argument"
    done
    mkdir -p "$destination" || exit 1
    artifact="$(cat "$behavior/artifact_dir")"
    cp "$artifact/charliebot" "$artifact/charliebot-server" "$artifact/sha256sums.txt" "$destination/" || exit 1
    ;;
  *)
    exit 2
    ;;
esac
